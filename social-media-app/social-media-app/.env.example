
NODE_ENV=development
PORT=3000

APPLICATION_NAME=social-media-app

DB_URL=mongodb://127.0.0.1:27017/social-media-app

REDIS_URI=redis://127.0.0.1:6379

UPLOADS_DIR=./uploads

CLIENT_IDS=

EMAIL_USER=
EMAIL_PASS=

user_access_token_secret=change-me-user-access
refresh_user_token_secret=change-me-user-refresh
system_access_token_secret=change-me-system-access
refresh_system_token_secret=change-me-system-refresh
access_token_expires_in=1800
refresh_token_expires_in=31536000

IV_LENGTH=16
ENCRYPTION_byte=change-me-32-byte-hex-key

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
